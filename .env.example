RESEND_API_KEY=re_your_api_key
CONTACT_TO_EMAIL=your-email@example.com
CONTACT_FROM_EMAIL=AgentSiraji Website <onboarding@resend.dev>
NEXT_PUBLIC_SITE_URL=https://agent-siraji.vercel.app

# AgentSiraji commercial platform database (server-only)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Server-only token protecting manual payment approval/rejection endpoints.
# Generate a long random value. Never expose this as NEXT_PUBLIC_*.
COMMERCIAL_ADMIN_REVIEW_TOKEN=replace_with_long_random_server_only_token

# SSLCOMMERZ sandbox — Bangladesh online checkout
SSLCOMMERZ_STORE_ID=your_sandbox_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sandbox_store_password
SSLCOMMERZ_SANDBOX=true

# Paddle sandbox — international subscription checkout
PADDLE_API_KEY=your_sandbox_api_key
PADDLE_WEBHOOK_SECRET=your_sandbox_webhook_secret
PADDLE_ENV=sandbox

# Bangladesh manual bank transfer — display only after real business account is ready
BD_BANK_NAME=your_business_bank_name
BD_BANK_ACCOUNT_NAME=your_business_account_name
BD_BANK_ACCOUNT_NUMBER=your_business_account_number
BD_BANK_BRANCH=your_business_bank_branch
BD_BANK_ROUTING_NUMBER=your_optional_routing_number

# International manual invoice / Payoneer
PAYONEER_PAYMENT_INSTRUCTIONS=Configured after business receiving details are approved
