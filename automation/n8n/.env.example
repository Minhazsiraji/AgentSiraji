# Copy to .env ON THE SERVER ONLY. Never commit .env.
# Set a DNS A record before starting; use a hostname you control.
N8N_DOMAIN=CHANGE_ME.your-domain.example
# Tested candidate version; validate and pin a supported current version at deployment.
N8N_VERSION=2.43.7
POSTGRES_DB=automation
POSTGRES_USER=automation
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_48_PLUS
N8N_ENCRYPTION_KEY=CHANGE_ME_RANDOM_48_PLUS
N8N_RUNNERS_AUTH_TOKEN=CHANGE_ME_RANDOM_48_PLUS
